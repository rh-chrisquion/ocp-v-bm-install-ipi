# Copy this file for an OP-V cluster and replace every required value.
# This is trusted shell input; keep it non-secret and review it before use.

CLUSTER_NAME="REPLACE_ME"
EXPECTED_API_HOST_FRAGMENT="api.REPLACE_ME."
EXPECTED_NODES="REPLACE_ME_NODE_NAMES_SEPARATED_BY_SPACES"

TEST_NAMESPACE="migration-readiness"
# Existing namespace used for server-side admission checks when TEST_NAMESPACE
# has not been created yet. The rendered apply manifest still uses TEST_NAMESPACE.
PLAN_NAMESPACE="default"
CSI_DRIVER_NAME="csi.hpe.com"
STORAGE_CLASS="REPLACE_ME"
STORAGE_WORKLOAD_NAMESPACE="hpe-storage"
STORAGE_BACKEND_SECRET_NAMESPACE="hpe-storage"
STORAGE_BACKEND_SECRET_NAME="hpe-backend-secret"
# Optional cluster-scoped or namespaced resource type for extra diagnostics.
STORAGE_CUSTOM_RESOURCE="hpecsidrivers.storage.hpe.com"
STORAGE_SMOKE_SIZE="1Gi"
STORAGE_SMOKE_ACCESS_MODE="ReadWriteOnce"
STORAGE_SMOKE_VOLUME_MODE="Filesystem"
# Optional space-separated host:port targets tested by collect --host.
ISCSI_PORTALS=""

VM_NAME="migration-readiness-vm"
VM_DISK_SIZE="20Gi"
VM_ACCESS_MODE="ReadWriteMany"
VM_VOLUME_MODE="Block"
VM_MEMORY="2Gi"
VM_CPU_CORES="1"
VM_BOOT_SOURCE_KIND="DataSource"
VM_BOOT_SOURCE_NAME="rhel9"
VM_BOOT_SOURCE_NAMESPACE="openshift-virtualization-os-images"
VM_READY_TIMEOUT_SECONDS="1800"
VM_MIGRATION_TIMEOUT_SECONDS="900"
MINIMUM_MIGRATION_NODES="2"
VIRTUALIZATION_NAMESPACE="openshift-cnv"
HYPERCONVERGED_NAME="kubevirt-hyperconverged"

# Space-separated full URLs. The active cluster API /readyz URL is automatic.
NETWORK_TEST_URLS=""
NETWORK_TEST_DURATION_SECONDS="60"
NETWORK_TEST_INTERVAL_SECONDS="1"
NETWORK_TEST_INSECURE="false"

RESILIENCY_NODE="${RESILIENCY_NODE:-}"
RESILIENCY_BOND="${RESILIENCY_BOND:-}"
RESILIENCY_MEMBER="${RESILIENCY_MEMBER:-}"
RESILIENCY_PEER_IP="${RESILIENCY_PEER_IP:-}"
RESILIENCY_PEER_PORT="${RESILIENCY_PEER_PORT:-}"
RESILIENCY_OUTAGE_SECONDS="${RESILIENCY_OUTAGE_SECONDS:-15}"
RESILIENCY_PING_INTERVAL_SECONDS="${RESILIENCY_PING_INTERVAL_SECONDS:-0.2}"
RESILIENCY_MAX_PACKET_LOSS_PERCENT="${RESILIENCY_MAX_PACKET_LOSS_PERCENT:-5}"
RESILIENCY_MAX_TCP_FAILURES="${RESILIENCY_MAX_TCP_FAILURES:-1}"

# node|bond|member|TCP peer|TCP port, one case per line.
NETWORK_RESILIENCY_CASES="${NETWORK_RESILIENCY_CASES:-}"

VM_RESILIENCY_NAMESPACE="${VM_RESILIENCY_NAMESPACE:-}"
VM_RESILIENCY_NAME="${VM_RESILIENCY_NAME:-}"
VM_RESILIENCY_SSH_USER="${VM_RESILIENCY_SSH_USER:-}"
VM_RESILIENCY_SSH_IDENTITY_FILE="${VM_RESILIENCY_SSH_IDENTITY_FILE:-}"
VM_RESILIENCY_NETWORK_NAME="${VM_RESILIENCY_NETWORK_NAME:-}"
VM_RESILIENCY_GUEST_INTERFACE="${VM_RESILIENCY_GUEST_INTERFACE:-}"
VM_RESILIENCY_TARGET_HOST="${VM_RESILIENCY_TARGET_HOST:-}"
VM_RESILIENCY_TARGET_PORT="${VM_RESILIENCY_TARGET_PORT:-}"
VM_RESILIENCY_BOND="${VM_RESILIENCY_BOND:-}"
VM_RESILIENCY_MEMBER="${VM_RESILIENCY_MEMBER:-}"
VM_RESILIENCY_TEST_DURATION_SECONDS="${VM_RESILIENCY_TEST_DURATION_SECONDS:-45}"
VM_RESILIENCY_MAX_TCP_FAILURES="${VM_RESILIENCY_MAX_TCP_FAILURES:-1}"
