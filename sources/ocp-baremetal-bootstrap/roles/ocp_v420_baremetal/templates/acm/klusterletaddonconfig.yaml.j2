apiVersion: agent.open-cluster-management.io/v1
kind: KlusterletAddonConfig
metadata:
  name: {{ ocp_cluster_name }}
  namespace: {{ ocp_acm_namespace }}
spec:
  clusterName: {{ ocp_cluster_name }}
  clusterNamespace: {{ ocp_acm_namespace }}
  clusterLabels:
    cloud: BareMetal
    vendor: OpenShift
  applicationManager:
    enabled: true
  policyController:
    enabled: true
  searchCollector:
    enabled: true
  certPolicyController:
    enabled: true
