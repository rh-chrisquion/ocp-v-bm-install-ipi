---
# Example only — not applied by terraform. Replace remoteRef.key with a real
# Secrets Manager secret name after the ClusterSecretStore is Ready.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: example-secret
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: example-secret
    creationPolicy: Owner
  data:
    - secretKey: my-secret-value
      remoteRef:
        key: my-app/secret
