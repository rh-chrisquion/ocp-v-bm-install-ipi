# Required authentication
rhcs_token = "REPLACE_WITH_OCM_API_TOKEN"

# Cluster identity
cluster_name      = "example-rosa-hub-hcp"
openshift_version = "4.22.0"

# AWS placement
aws_region             = "us-east-2"
aws_availability_zones = ["us-east-2a", "us-east-2b", "us-east-2c"]
aws_subnet_ids         = ["subnet-aaaaaaaa", "subnet-bbbbbbbb", "subnet-cccccccc"]
machine_cidr           = "10.200.0.0/16"

# STS role/OIDC settings (module-managed)
account_role_prefix  = "example-rosa-hub"
operator_role_prefix = "example-rosa-hub-operators"

# Worker sizing for ACM + AAP + ArgoCD hub workloads
compute_machine_type = "m5.2xlarge"
replicas             = 6

# Autoscaling for HCP worker pools
# Hub HA baseline for ACM+AAP+Argo CD: 2 workers per AZ (3 AZ => 6 total min).
enable_autoscaled_machine_pools = true
min_replicas_per_pool           = 2
max_replicas_per_pool           = 6

tags = {
  environment = "example"
  owner       = "platform-team"
  managed_by  = "terraform"
}
