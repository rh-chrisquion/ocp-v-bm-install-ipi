# Required authentication
rhcs_token = "REPLACE_WITH_OCM_API_TOKEN"

# Cluster identity
cluster_name      = "example-rosa-hub-hcp"
openshift_version = "4.22.0"

# Environment slug used in required organizational tagging (see locals.tf)
env = "sandbox"

# AWS placement
aws_region = "us-east-2"

# Cross-account access (optional): if you're running this against a client's
# AWS account via a role they granted you, rather than native credentials in
# that account, set aws_assume_role_arn. Leave commented out to use ambient
# credentials (CLI profile, SSO session, GitHub Actions creds) directly.
# aws_assume_role_arn          = "arn:aws:iam::123456789012:role/ClientGrantedTerraformRole"
# aws_assume_role_external_id  = "REPLACE_IF_REQUIRED_BY_TRUST_POLICY"

# VPC/subnet/CIDR auto-discovery (default: enabled)
# By default, aws_subnet_ids, aws_availability_zones, and machine_cidr are
# auto-discovered from AWS by looking up a VPC tagged Name="${network_name}-vpc"
# and its subnets tagged per private_subnet_selector_tags (default
# Attributes="private"). network_name must match the sibling
# rosa-hcp-network-terraform stack's network_name.
# network_name          = "rosa-hcp-hub-network"
# enable_vpc_discovery  = true
# private_subnet_selector_tags = {
#   Attributes = "private"
# }

# Manual override (optional): set these to skip auto-discovery for any field,
# or set enable_vpc_discovery = false to require them all explicitly.
# aws_availability_zones = ["us-east-2a", "us-east-2b", "us-east-2c"]
# aws_subnet_ids         = ["subnet-aaaaaaaa", "subnet-bbbbbbbb", "subnet-cccccccc"]
# machine_cidr           = "10.200.0.0/16"

# STS role/OIDC settings (module-managed)
account_role_prefix  = "example-rosa-hub"
operator_role_prefix = "example-rosa-hub-operators"

# Worker sizing for ACM + AAP + ArgoCD hub workloads
compute_machine_type = "m5.2xlarge"
replicas             = 6

# Autoscaling for HCP worker pools
# Hub HA baseline for ACM+AAP+Argo CD: 2 workers per AZ (3 AZ => 6 total min).
enable_autoscaled_machine_pools = true
min_replicas_per_pool           = 2
max_replicas_per_pool           = 6

tags = {
  environment = "example"
  owner       = "platform-team"
  managed_by  = "terraform"
}

# --- Identity providers ---

# Sandbox/dev: Terraform-managed htpasswd cluster-admin (default: enabled).
# Generated password is available via: terraform output -raw htpasswd_admin_password
# create_htpasswd_admin  = true
# htpasswd_admin_username = "sandbox-admin"

# Client/production: OIDC IDP fronted by your organization's SSO (Duo 2FA, or
# whatever MFA your org uses, is enforced by that upstream IdP -- this only
# registers the cluster as an OIDC relying party of it). Requires an OIDC
# client already registered against that IdP; set enable_oidc_idp = true and
# fill these in once you have that registration. Disable create_htpasswd_admin
# once this is in place for a shared/production cluster.
# enable_oidc_idp     = true
# oidc_idp_name       = "corporate-sso"
# oidc_issuer_url     = "https://sso.example.com/realms/your-realm"
# oidc_client_id      = "rosa-hub-cluster"
# oidc_client_secret  = "REPLACE_WITH_OIDC_CLIENT_SECRET"
# oidc_admin_username = "you@example.com"

# --- Bastion host (only meaningful when private_cluster = true) ---
# SSM Session Manager-only jump host for reaching the API/console once they
# have no public endpoint. See "Connecting to a private cluster via the
# bastion host" in README.md for client-side connection steps.
# create_bastion        = true
# bastion_instance_type = "t3.micro"

# --- Day-1 OLM operators (default: enabled) ---
# terraform apply installs OpenShift GitOps + External Secrets Operator from
# ../manifests/, waits for CSVs, then sets installPlanApproval=Manual.
# Requires `oc` on PATH, create_htpasswd_admin=true, and API reachability
# (for private_cluster=true: VPN/TGW or an active bastion SSM port-forward).
# install_day1_operators = true
